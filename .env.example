# Anthropic — powers all appraisals (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — $30/mo subscription (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PRICE_ID=price_...   # a recurring $30/month price
STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` in dev, or the endpoint's signing secret in the dashboard

# Random long string used to sign usage/pro cookies (e.g. `openssl rand -hex 32`)
APP_SECRET=change-me-to-a-long-random-string

# Base URL of the deployed site (http://localhost:3000 in dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Postgres for accounts (Neon, Railway, Vercel Postgres free tiers all work).
# Prisma CLI reads .env, not .env.local — mirror this value into a plain
# .env too so `npx prisma migrate dev` works without manually passing it.
DATABASE_URL=postgres://...

# Resend — magic-link sign-in emails (resend.com). Optional in dev: without
# a key, links print to the server console instead of sending.
RESEND_API_KEY=re_...
EMAIL_FROM=Lowballer <hello@lowballer.org>

# Upstash Redis (upstash.com, free tier) — shared-state rate limiting for
# /api/appraise and /api/auth/login. Required; without it those routes will
# error, since lib/rateLimit.js has no in-memory fallback (an in-memory
# limiter provides close to no real protection on Vercel's serverless
# instances — confirmed by testing, not just theory).
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
