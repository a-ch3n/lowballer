# Anthropic — powers all appraisals (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — $30/mo subscription (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PRICE_ID=price_...   # a recurring $30/month price

# Random long string used to sign usage/pro cookies (e.g. `openssl rand -hex 32`)
APP_SECRET=change-me-to-a-long-random-string

# Base URL of the deployed site (http://localhost:3000 in dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
